diff --git a/test/test_gps_layout/test_main.cpp b/test/test_gps_layout/test_main.cpp
new file mode 100644
index 0000000..3c57af6
--- /dev/null
+++ b/test/test_gps_layout/test_main.cpp
@@ -0,0 +1,127 @@
+#include <unity.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "DisplayLine.h"
+
+// Layout budget for the GPS data screens on a 128 x 128 panel.
+//
+// The screens draw their lines with Display::printWrapped, which breaks a line that is
+// wider than the panel into consecutive rows of STANDARD_FONT_CHAR_LIMIT characters and
+// advances the cursor one 8 px row per line. Nothing scrolls, so if the rows needed
+// exceed the rows that fit, the tail of the screen is drawn off the bottom of the panel.
+// These tests pin that budget so a field added to either screen fails here instead of
+// silently vanishing on the device.
+//
+// Constants mirrored from the firmware (source of truth in brackets):
+//   panel                 128 x 128   (User_Setup_marauder_mini_v3.h)
+//   chars per row         21          (STANDARD_FONT_CHAR_LIMIT)
+//   row pitch             8 px        (TFT_eSPI built-in font, textsize 1)
+//   tracker start y       36          (WiFiScan.cpp: (SCREEN_HEIGHT / 3) - 6)
+//   gps-info start y      42          (WiFiScan.cpp: SCREEN_HEIGHT / 3)
+#define CHARS_PER_ROW 21
+#define ROW_PITCH 8
+#define PANEL_HEIGHT 128
+#define TRACKER_TOP 36
+#define GPSINFO_TOP 42
+
+static int rows_for(const char* line) {
+  return (int)displayLineRowCount(line, CHARS_PER_ROW);
+}
+
+void setUp() {}
+void tearDown() {}
+
+// --- the wrap is load-bearing -------------------------------------------------------
+
+void test_datetime_line_is_too_long_for_one_row() {
+  // 23 characters: the stamp that was being cut off mid-string on the device.
+  const char* dt = "UTC 2026-10-01T12:34:56";
+  TEST_ASSERT_EQUAL_INT(23, (int)strlen(dt));
+  TEST_ASSERT_EQUAL_INT(2, rows_for(dt));
+}
+
+void test_wrapped_datetime_keeps_every_character() {
+  const char* dt = "  D/T: 2026-10-01T12:34:56";
+  char row[CHARS_PER_ROW + 1];
+  copyDisplayLineRow(row, sizeof(row), dt, 0, CHARS_PER_ROW);
+  TEST_ASSERT_EQUAL_STRING("  D/T: 2026-10-01T12:", row);
+  copyDisplayLineRow(row, sizeof(row), dt, 1, CHARS_PER_ROW);
+  TEST_ASSERT_EQUAL_STRING("34:56", row);
+}
+
+// --- the tracker screen fits its budget ---------------------------------------------
+
+void test_tracker_screen_worst_case_fits_the_panel(void) {
+  // Widest realistic values for every field on the compact tracker screen.
+  const char* lines[] = {
+    "  SAT 12  23:59:59",              // 1 row
+    "DIST 1234.56 km",                 // 1 row
+    "LAT  -122.123456",                // 1 row
+    "LON  -122.123456",                // 1 row
+    "ALT -1234.5m  ACC 123.4m",        // 2 rows
+    "SPD 123.4km/h  PTS 123456",       // 2 rows
+    "UTC 2026-10-01T12:34:56",         // 2 rows
+  };
+  const int fix_row = 1;               // the FIX / NO FIX word, printed unwrapped
+  int total = fix_row;
+  for (unsigned i = 0; i < sizeof(lines) / sizeof(lines[0]); i++)
+    total += rows_for(lines[i]);
+
+  TEST_ASSERT_EQUAL_INT(11, total);
+  int rows_that_fit = (PANEL_HEIGHT - TRACKER_TOP) / ROW_PITCH;
+  TEST_ASSERT_EQUAL_INT(11, rows_that_fit);
+  TEST_ASSERT_TRUE_MESSAGE(total <= rows_that_fit,
+                           "compact GPS tracker screen overflows the panel");
+}
+
+void test_tracker_screen_typical_case_leaves_a_margin(void) {
+  const char* lines[] = {
+    "  SAT 07  00:12:34",
+    "DIST 1.23 km",
+    "LAT  37.123456",
+    "LON  -122.123456",
+    "ALT 12.3m  ACC 4.5m",
+    "SPD 1.2km/h  PTS 120",
+    "UTC 2026-10-01T12:34:56",
+  };
+  int total = 1;
+  for (unsigned i = 0; i < sizeof(lines) / sizeof(lines[0]); i++)
+    total += rows_for(lines[i]);
+  TEST_ASSERT_EQUAL_INT(9, total);
+  TEST_ASSERT_TRUE(total < (PANEL_HEIGHT - TRACKER_TOP) / ROW_PITCH);
+}
+
+// --- the GPS info screen fits its budget --------------------------------------------
+
+void test_gps_info_screen_worst_case_fits_the_panel(void) {
+  const char* lines[] = {
+    "  Good Fix: No",                  // 1
+    "      Text: waypoint-name-here",  // 2
+    " Sats: 12 ",                      // 1
+    "  Acc: 123.4",                    // 1
+    "  Lat: -122.123456",              // 1
+    "  Lon: -122.123456",              // 1
+    "  Alt: -1234",                    // 1
+    "  D/T: 2026-10-01T12:34:56",      // 2
+  };
+  int total = 0;
+  for (unsigned i = 0; i < sizeof(lines) / sizeof(lines[0]); i++)
+    total += rows_for(lines[i]);
+
+  TEST_ASSERT_EQUAL_INT(10, total);
+  int rows_that_fit = (PANEL_HEIGHT - GPSINFO_TOP) / ROW_PITCH;
+  TEST_ASSERT_EQUAL_INT(10, rows_that_fit);
+  TEST_ASSERT_TRUE_MESSAGE(total <= rows_that_fit,
+                           "GPS info screen overflows the panel");
+}
+
+int main(int, char**) {
+  UNITY_BEGIN();
+  RUN_TEST(test_datetime_line_is_too_long_for_one_row);
+  RUN_TEST(test_wrapped_datetime_keeps_every_character);
+  RUN_TEST(test_tracker_screen_worst_case_fits_the_panel);
+  RUN_TEST(test_tracker_screen_typical_case_leaves_a_margin);
+  RUN_TEST(test_gps_info_screen_worst_case_fits_the_panel);
+  return UNITY_END();
+}
