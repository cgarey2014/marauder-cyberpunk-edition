+#ifdef MARAUDER_MINI_V3
+// Mini v3 boot splash: a synthwave sunset scene with the CP EDITION wordmark and the
+// "Jacking in..." tagline.
+//
+// The scene is a run table, so it draws as one drawFastHLine per horizontal run
+// with no intermediate buffer, and it is drawn at native 128 x 72 (never
+// resampled). The wordmark is drawn twice with a one pixel offset in magenta then
+// cyan, which gives it the chromatic fringing that matches the scene.
+void Display::drawCosmoBootSplash(int16_t width, int16_t height) {
+  const marauder::CosmoSplashLayout layout =
+      marauder::cosmoSplashLayout(width, height);
+
+  tft.setTextSize(1);
+  tft.setTextColor(NEON_WHITE, TFT_BLACK);
+  tft.drawCentreString("ESP32 Marauder", width / 2, layout.title_y, 1);
+
+  for (uint16_t i = 0; i < marauder::kBootSceneRunCount; i++) {
+    const marauder::BootSceneRun& run = marauder::kBootSceneRuns[i];
+    tft.drawFastHLine(layout.scene_x + run.x, layout.scene_y + run.y,
+                      run.length, marauder::kScenePalette[run.colour]);
+  }
+
+  // The wordmark is two lines: "CYBERPUNK EDITION" on one font 2 line would be 136 px on
+  // this 128 px panel, so the second word sits under the first at the small font.
+  const int16_t wordmark_width = tft.textWidth("CYBERPUNK", 2);
+  int16_t wordmark_x = (width - wordmark_width) / 2;
+  if (wordmark_x < 0) wordmark_x = 0;
+  tft.setTextSize(1);
+  tft.setTextColor(NEON_MAGENTA, TFT_BLACK);
+  tft.drawString("CYBERPUNK", wordmark_x + 1, layout.wordmark_y, 2);
+  tft.setTextColor(NEON_CYAN, TFT_BLACK);
+  tft.drawString("CYBERPUNK", wordmark_x, layout.wordmark_y, 2);
+
+  tft.setTextColor(NEON_MAGENTA, TFT_BLACK);
+  tft.drawCentreString("EDITION", width / 2, layout.wordmark2_y, 1);
+
+  tft.setTextColor(NEON_YELLOW, TFT_BLACK);
+  tft.drawCentreString("Jacking in...", width / 2, layout.tagline_y, 1);
+  tft.setTextColor(NEON_SKYBLUE, TFT_BLACK);
+  tft.drawCentreString(version_number, width / 2, layout.version_y, 1);
+  tft.setTextSize(1);
 }
+#endif
 
