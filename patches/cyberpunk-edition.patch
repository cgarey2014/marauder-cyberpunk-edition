--- a/esp32_marauder/BootSplash.h
+++ b/esp32_marauder/BootSplash.h
@@ -19,4 +19,25 @@ BootSplashLayout bootSplashLayout(int16_t screen_width,
                                   int16_t screen_height,
                                   bool half_scale_logo = false);
 
+// Band positions for the Mini v3 boot splash: product title, the synthwave sunset
+// scene, the "CP EDITION" wordmark, the "Jacking in..." tagline, then the version.
+struct CosmoSplashLayout {
+  int16_t title_y;
+  int16_t scene_x;
+  int16_t scene_y;
+  int16_t scene_width;
+  int16_t scene_height;
+  int16_t wordmark_y;
+  int16_t wordmark2_y;
+  int16_t tagline_y;
+  int16_t version_y;
+};
+
+// Lays the bands out on a panel of the given size. The scene keeps its native pixel
+// size (it is a hard one-pixel-per-pixel scene and must not be resampled); the bands
+// are stacked from the top and the whole stack is shifted up if it would run past the
+// bottom edge.
+CosmoSplashLayout cosmoSplashLayout(int16_t screen_width,
+                                    int16_t screen_height);
+
 }  // namespace marauder
