+// --- row wrapping (Mini v3: 21 characters per row) ---
+
+constexpr uint16_t kCap = 21;
+
+void test_short_line_needs_one_row() {
+  TEST_ASSERT_EQUAL_UINT16(1, displayLineRowCount("AP -45 ch 6", kCap));
+}
+
+void test_mac_line_with_label_needs_two_rows() {
+  // "   BSSID: AA:BB:CC:DD:EE:FF" is 27 characters on a row that holds 21.
+  TEST_ASSERT_EQUAL_UINT16(2, displayLineRowCount("   BSSID: AA:BB:CC:DD:EE:FF", kCap));
+}
+
+void test_mac_line_rows_reassemble_the_address() {
+  const char* line = "   BSSID: AA:BB:CC:DD:EE:FF";
+  char first[22];
+  char second[22];
+
+  copyDisplayLineRow(first, sizeof(first), line, 0, kCap);
+  copyDisplayLineRow(second, sizeof(second), line, 1, kCap);
+
+  // Every character of the address survives the split; the continuation row
+  // carries the remainder of the MAC.
+  TEST_ASSERT_EQUAL_STRING("   BSSID: AA:BB:CC:DD", first);
+  TEST_ASSERT_EQUAL_STRING(":EE:FF", second);
+  TEST_ASSERT_EQUAL_UINT(27, strlen(first) + strlen(second));
+}
+
+void test_bare_mac_address_fits_one_row() {
+  // A MAC on its own is 17 characters, so it never needed wrapping; it must
+  // still come out of the wrapper untouched.
+  TEST_ASSERT_EQUAL_UINT16(1, displayLineRowCount("AA:BB:CC:DD:EE:FF", kCap));
+}
+
+void test_exact_multiple_needs_no_spare_row() {
+  // A row that exactly fills the capacity must not open a spare row.
+  const std::string exactly_two_rows(2 * kCap, 'x');
+  const std::string one_more(exactly_two_rows + "x");
+
+  TEST_ASSERT_EQUAL_UINT16(2, displayLineRowCount(exactly_two_rows.c_str(), kCap));
+  TEST_ASSERT_EQUAL_UINT16(3, displayLineRowCount(one_more.c_str(), kCap));
+  TEST_ASSERT_EQUAL_UINT16(1, displayLineRowCount(std::string(kCap, 'x').c_str(), kCap));
+}
+
+void test_embedded_newline_forces_a_row_break() {
+  const char* line = "AA:BB:CC:DD:EE:FF\n192.168.4.1\nconnected";
+  TEST_ASSERT_EQUAL_UINT16(3, displayLineRowCount(line, kCap));
+
+  char row[24];
+  copyDisplayLineRow(row, sizeof(row), line, 0, kCap);
+  TEST_ASSERT_EQUAL_STRING("AA:BB:CC:DD:EE:FF", row);
+  copyDisplayLineRow(row, sizeof(row), line, 1, kCap);
+  TEST_ASSERT_EQUAL_STRING("192.168.4.1", row);
+  copyDisplayLineRow(row, sizeof(row), line, 2, kCap);
+  TEST_ASSERT_EQUAL_STRING("connected", row);
+}
+
+void test_a_wrapped_row_is_terminated_not_padded() {
+  // The continuation row carries only its own characters: the caller pads the
+  // last row of a line when it needs to erase what was there before.
+  char row[kCap + 1];
+  copyDisplayLineRow(row, sizeof(row), "   BSSID: AA:BB:CC:DD:EE:FF", 1, kCap);
+
+  TEST_ASSERT_EQUAL_STRING(":EE:FF", row);
+  TEST_ASSERT_EQUAL_UINT(6, strlen(row));
+  TEST_ASSERT_EQUAL_CHAR('\0', row[6]);
+}
+
+void test_row_past_the_end_is_empty() {
+  char row[8];
+  TEST_ASSERT_EQUAL_UINT(0, copyDisplayLineRow(row, sizeof(row), "AP", 7, kCap));
+  TEST_ASSERT_EQUAL_STRING("", row);
