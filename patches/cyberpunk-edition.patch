+  TEST_ASSERT_EQUAL_UINT16(1, displayLineRowCount(nullptr, kCap));
+  copyDisplayLineRow(row, sizeof(row), "", 0, kCap);
+  TEST_ASSERT_EQUAL_STRING("", row);
