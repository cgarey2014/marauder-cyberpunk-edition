+#pragma once
+
+#include <stdint.h>
+
+// Neon cyberpunk UI palette for the Marauder Mini v3.
+//
+// Generated by tools/generate_neon_palette.py, which computes each entry's WCAG
+// contrast ratio against the backgrounds it is actually drawn on and refuses to
+// emit a palette where body text fails. Do not hand-edit: change the generator.
+//
+// The panel is driven with native RGB565 - this firmware creates no sprites and
+// never calls setColorDepth - so these constants reach the display unquantised.
+//
+// How the theme is applied: the firmware sources name colours NEON_<NAME> rather
+// than TFT_<NAME>. On the Mini v3 those expand to the neon entries below; on any
+// other target they expand to the stock TFT_eSPI macro, so this file changes
+// nothing at all for other boards. The mapping is deliberately one macro per
+// legacy token name - merging two legacy names onto one macro would change the
+// value those other targets use.
+//
+// Measured contrast:
+//   kNeonBody        black  19.42:1   status bar  17.83:1
+//   kNeonAccent      black  13.53:1   status bar  12.42:1
+//   kNeonOk          black  15.88:1   status bar  14.59:1
+//   kNeonWarn        black   9.24:1   status bar   8.49:1
+//   kNeonAlarm       black   5.80:1   status bar   5.32:1
+//   kNeonHot         black   6.70:1   status bar   6.16:1
+//   kNeonAlert       black  16.73:1   status bar  15.36:1
+//   kNeonInfo        black   9.04:1   status bar   8.30:1
+//   kNeonLime        black  15.96:1   status bar  14.66:1
+//   kNeonPurple      black   6.67:1   status bar   6.13:1
+//   kNeonSky         black  15.29:1   status bar  14.04:1
+//   kNeonSilver      black  15.43:1   status bar  14.17:1
+//   kNeonMuted       black   8.24:1   status bar   7.57:1
+//   kNeonWhite       black  21.00:1   status bar  19.29:1
+
+namespace marauder {
+
+// --- neon palette --------------------------------------------------------------------
+constexpr uint16_t kNeonBody        = 0xEFBF;  // 0xEAF7FF  primary body and menu text, cool white
+constexpr uint16_t kNeonAccent      = 0x4F1D;  // 0x4FE3EE  image cyan - scanners, primary accents
+constexpr uint16_t kNeonOk          = 0x4FEF;  // 0x4DFF7A  hacker green - GPS, success, WiFi, connected
+constexpr uint16_t kNeonWarn        = 0xFC6A;  // 0xFF8C55  image orange - files, SD, uploads, counters
+constexpr uint16_t kNeonAlarm       = 0xF98A;  // 0xFF3355  cyberpunk red - attacks, errors, warnings
+constexpr uint16_t kNeonHot         = 0xEA7A;  // 0xED4FD0  image magenta - recon, highlights, selection
+constexpr uint16_t kNeonAlert       = 0xFF26;  // 0xFFE633  image yellow - choices, confirmations, attention
+constexpr uint16_t kNeonInfo        = 0x7D5F;  // 0x7FA8FF  image blue-grey, lifted - wardriving, info
+constexpr uint16_t kNeonLime        = 0xA7A7;  // 0xA6F53C  warning lime - fox hunt, geofences
+constexpr uint16_t kNeonPurple      = 0xB39E;  // 0xB071F0  image purple, lifted - Bluetooth
+constexpr uint16_t kNeonSky         = 0x9F3F;  // 0x9FE4FF  pale cyan tint - sniffers (low saturation, see rule 2)
+constexpr uint16_t kNeonSilver      = 0xCEFD;  // 0xCFDCEE  neutral - settings and configuration
+constexpr uint16_t kNeonMuted       = 0x9518;  // 0x93A2C0  de-emphasised - Back and exit items, still readable
+constexpr uint16_t kNeonWhite       = 0xFFFF;  // 0xFFFFFF  maximum emphasis
+constexpr uint16_t kNeonBlack          = 0x0000;  // panel background
+
+// --- status bar and title text -------------------------------------------------------
+// The stock status bar is flat mid-grey (0x4A49). A deep indigo keeps the neon text
+// on it high contrast and makes the bar read as part of the theme.
+constexpr uint16_t kNeonStatusBar   = 0x1045;
+constexpr uint16_t kNeonTitleText   = 0x0021;  // text on a bright title bar
+
+// --- stock values, mirrored for the firmware-side static_assert -----------------------
+constexpr uint16_t kLegacyNavy           = 0x000F;  // TFT_NAVY
+constexpr uint16_t kLegacyBlue           = 0x001F;  // TFT_BLUE
+constexpr uint16_t kLegacyDarkcyan       = 0x03EF;  // TFT_DARKCYAN
+constexpr uint16_t kLegacyCyan           = 0x07FF;  // TFT_CYAN
+constexpr uint16_t kLegacyDarkgreen      = 0x03E0;  // TFT_DARKGREEN
+constexpr uint16_t kLegacyGreen          = 0x07E0;  // TFT_GREEN
+constexpr uint16_t kLegacyMaroon         = 0x7800;  // TFT_MAROON
+constexpr uint16_t kLegacyRed            = 0xF800;  // TFT_RED
+constexpr uint16_t kLegacyPurple         = 0x780F;  // TFT_PURPLE
+constexpr uint16_t kLegacyViolet         = 0x915C;  // TFT_VIOLET
+constexpr uint16_t kLegacyOlive          = 0x7BE0;  // TFT_OLIVE
+constexpr uint16_t kLegacyGreenyellow    = 0xB7E0;  // TFT_GREENYELLOW
+constexpr uint16_t kLegacyLightgrey      = 0xD69A;  // TFT_LIGHTGREY
+constexpr uint16_t kLegacySilver         = 0xC618;  // TFT_SILVER
+constexpr uint16_t kLegacyDarkgrey       = 0x7BEF;  // TFT_DARKGREY
+constexpr uint16_t kLegacyMagenta        = 0xF81F;  // TFT_MAGENTA
+constexpr uint16_t kLegacyPink           = 0xFE19;  // TFT_PINK
+constexpr uint16_t kLegacyYellow         = 0xFFE0;  // TFT_YELLOW
+constexpr uint16_t kLegacyGold           = 0xFEA0;  // TFT_GOLD
+constexpr uint16_t kLegacyOrange         = 0xFDA0;  // TFT_ORANGE
+constexpr uint16_t kLegacySkyblue        = 0x867D;  // TFT_SKYBLUE
+constexpr uint16_t kLegacyWhite          = 0xFFFF;  // TFT_WHITE
+
+}  // namespace marauder
+
