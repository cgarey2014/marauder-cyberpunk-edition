diff --git a/esp32_marauder/DisplayLine.cpp b/esp32_marauder/DisplayLine.cpp
index 813218c..b745deb 100644
--- a/esp32_marauder/DisplayLine.cpp
+++ b/esp32_marauder/DisplayLine.cpp
@@ -24,3 +24,99 @@ uint8_t resolveDisplayTextSize(bool small_print, uint8_t requested_size) {
 
   return requested_size > 0 ? requested_size : 1;
 }
+
+namespace {
+
+// Locates row `target` of `input`. Rows are `capacity` characters long and are
+// additionally broken at every '\n'. Returns false once the input is exhausted.
+bool displayLineRowSpan(const char* input, uint16_t target, uint16_t capacity,
+                        size_t* start, size_t* length) {
+  size_t offset = 0;
+  uint16_t row = 0;
+
+  while (true) {
+    size_t segment_end = offset;
+    while ((input[segment_end] != '\0') && (input[segment_end] != '\n'))
+      ++segment_end;
+
+    const size_t segment_length = segment_end - offset;
+    size_t segment_rows = (segment_length + capacity - 1) / capacity;
+    if (segment_rows == 0)
+      segment_rows = 1;
+
+    if (target < row + segment_rows) {
+      const size_t row_in_segment = target - row;
+      const size_t row_start = offset + (row_in_segment * capacity);
+      const size_t row_length = segment_length - (row_in_segment * capacity);
+
+      *start = row_start;
+      *length = row_length < capacity ? row_length : capacity;
+      return true;
+    }
+
+    row += static_cast<uint16_t>(segment_rows);
+    if (input[segment_end] == '\0')
+      return false;
+    offset = segment_end + 1;
+  }
+}
+
+}  // namespace
+
+uint16_t displayLineRowCount(const char* input, uint16_t capacity) {
+  if (input == nullptr)
+    return 1;
+  if (capacity == 0)
+    capacity = 1;
+
+  uint16_t rows = 0;
+  size_t offset = 0;
+
+  while (true) {
+    size_t segment_end = offset;
+    while ((input[segment_end] != '\0') && (input[segment_end] != '\n'))
+      ++segment_end;
+
+    const size_t segment_length = segment_end - offset;
+    size_t segment_rows = (segment_length + capacity - 1) / capacity;
+    if (segment_rows == 0)
+      segment_rows = 1;
+
+    rows = static_cast<uint16_t>(rows + segment_rows);
+    if (rows >= kDisplayLineMaxRows)
+      return kDisplayLineMaxRows;
+
+    if (input[segment_end] == '\0')
+      return rows;
+    offset = segment_end + 1;
+  }
+}
+
+size_t copyDisplayLineRow(char* output, size_t output_size, const char* input,
+                          uint16_t row, uint16_t capacity) {
+  if ((output == nullptr) || (output_size == 0))
+    return 0;
+
+  output[0] = '\0';
+
+  if (input == nullptr)
+    return 0;
+
+  if (capacity == 0)
+    capacity = 1;
+  if (capacity >= output_size)
+    capacity = static_cast<uint16_t>(output_size - 1);
+
+  size_t start = 0;
+  size_t length = 0;
+  if (!displayLineRowSpan(input, row, capacity, &start, &length))
+    return 0;
+
+  if (length >= output_size)
+    length = output_size - 1;
+  if (length > 0)
+    memcpy(output, input + start, length);
+  output[length] = '\0';
+
+  return length;
+}
