+CosmoSplashLayout cosmoSplashLayout(int16_t screen_width,
+                                    int16_t screen_height) {
+  // Pixel budget. The GLCD font is 6 x 8, a font 2 wordmark line is 16 px tall, so on the
+  // 128 x 128 Mini v3 panel each band owns these rows:
+  //
+  //   title      y =   1 ..   8   ("ESP32 Marauder", GLCD 8 px)
+  //   scene      y =  10 ..  81   (128 x 72 sunset, full width)
+  //   CYBERPUNK  y =  83 ..  98   (font 2, 16 px - the first wordmark line)
+  //   EDITION    y =  99 .. 106   (GLCD 8 px - the second, smaller wordmark line)
+  //   tagline    y = 108 .. 115   ("Jacking in...", GLCD 8 px)
+  //   version    y = 116 .. 123
+  //
+  // Two wordmark lines are what fits: "CYBERPUNK EDITION" on one line at font 2 would be
+  // 136 px on a 128 px panel. The bands are disjoint and the last ends inside the panel.
+  constexpr int16_t kSceneWidth = 128;
+  constexpr int16_t kSceneHeight = 72;
+  constexpr int16_t kWordmarkHeight = 16;
+  constexpr int16_t kLineHeight = 8;
+  constexpr int16_t kGapAfterTitle = 1;
+  constexpr int16_t kGapAfterScene = 1;
+  constexpr int16_t kGapAfterWordmark2 = 1;
+  constexpr int16_t kGapAfterTagline = 0;
+  constexpr int16_t kBottomMargin = 4;
+
+  CosmoSplashLayout layout{};
+  layout.title_y = 1;
+  layout.scene_width = kSceneWidth;
+  layout.scene_height = kSceneHeight;
+  layout.scene_x = (screen_width - kSceneWidth) / 2;
+  if (layout.scene_x < 0) layout.scene_x = 0;
+  layout.scene_y = layout.title_y + kLineHeight + kGapAfterTitle;
+  layout.wordmark_y = layout.scene_y + kSceneHeight + kGapAfterScene;
+  layout.wordmark2_y = layout.wordmark_y + kWordmarkHeight;
+  layout.tagline_y = layout.wordmark2_y + kLineHeight + kGapAfterWordmark2;
+  layout.version_y = layout.tagline_y + kLineHeight + kGapAfterTagline;
+
+  // Shift the whole stack up if it would overrun a shorter panel.
+  const int16_t overrun =
+      (layout.version_y + kLineHeight + kBottomMargin) - screen_height;
+  if (overrun > 0) {
+    layout.title_y -= overrun;
+    layout.scene_y -= overrun;
+    layout.wordmark_y -= overrun;
+    layout.wordmark2_y -= overrun;
+    layout.tagline_y -= overrun;
+    layout.version_y -= overrun;
+  }
+
+  return layout;
+}
+
 }  // namespace marauder
