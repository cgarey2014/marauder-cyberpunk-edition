new file mode 100644
index 0000000..f6925d1
--- /dev/null
+++ b/test/test_neon_palette/test_main.cpp
@@ -0,0 +1,248 @@
+#include <unity.h>
+
+#include <math.h>
+#include <stdint.h>
+
+// The theme is applied through these macros, so define the target before pulling
+// the palette in: this is the same expansion the Mini v3 firmware build uses.
+#define MARAUDER_MINI_V3
+#include "NeonPalette.h"
+
+void setUp() {}
+void tearDown() {}
+
+namespace {
+
+float channel(float c) {
+  return c <= 0.03928f ? c / 12.92f : powf((c + 0.055f) / 1.055f, 2.4f);
+}
+
+// Repeats the unpacking the generator uses: RGB565 -> 0..255 per channel.
+float relative_luminance(uint16_t packed) {
+  const uint8_t r5 = (packed >> 11) & 0x1F;
+  const uint8_t g6 = (packed >> 5) & 0x3F;
+  const uint8_t b5 = packed & 0x1F;
+  const float r = ((r5 << 3) | (r5 >> 2)) / 255.0f;
+  const float g = ((g6 << 2) | (g6 >> 4)) / 255.0f;
+  const float b = ((b5 << 3) | (b5 >> 2)) / 255.0f;
+  return 0.2126f * channel(r) + 0.7152f * channel(g) + 0.0722f * channel(b);
+}
+
+float contrast_ratio(uint16_t a, uint16_t b) {
+  const float la = relative_luminance(a);
+  const float lb = relative_luminance(b);
+  const float lighter = la > lb ? la : lb;
+  const float darker = la > lb ? lb : la;
+  return (lighter + 0.05f) / (darker + 0.05f);
+}
+
+// Six 60-degree hue sectors, so "is this palette more than one colour" is a
+// question with a numeric answer rather than an opinion.
+int hue_sector(uint16_t packed) {
+  const float r = ((packed >> 11) & 0x1F) / 31.0f;
+  const float g = ((packed >> 5) & 0x3F) / 63.0f;
+  const float b = (packed & 0x1F) / 31.0f;
+  const float max = fmaxf(r, fmaxf(g, b));
+  const float min = fminf(r, fminf(g, b));
+  const float delta = max - min;
+  if (delta < 0.05f)
+    return -1;  // effectively neutral
+  float hue;
+  if (max == r)
+    hue = 60.0f * fmodf((g - b) / delta, 6.0f);
+  else if (max == g)
+    hue = 60.0f * (((b - r) / delta) + 2.0f);
+  else
+    hue = 60.0f * (((r - g) / delta) + 4.0f);
+  if (hue < 0) hue += 360.0f;
+  int sector = static_cast<int>(hue / 60.0f);
+  return sector % 6;
+}
+
+}  // namespace
+
+// --- the macro mapping actually points at the neon entries ----------------------
+
+void test_every_colour_name_resolves_to_its_neon_entry() {
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonBody,      NEON_LIGHTGREY);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonAccent,    NEON_CYAN);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonOk,        NEON_GREEN);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonWarn,      NEON_ORANGE);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonAlarm,     NEON_RED);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonHot,       NEON_MAGENTA);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonAlert,     NEON_YELLOW);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonInfo,      NEON_BLUE);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonMuted,     NEON_DARKGREY);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonSilver,    NEON_SILVER);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonSky,       NEON_SKYBLUE);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonPurple,    NEON_PURPLE);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonLime,      NEON_LIME);
+  TEST_ASSERT_EQUAL_UINT16(marauder::kNeonWhite,     NEON_WHITE);
+}
+
+// Several names deliberately resolve to one entry, so that items of the same kind read
+// as the same colour instead of competing variants of it. These pairings are the point
+// of the scheme, not an accident of the generator.
+void test_same_kind_colours_share_one_entry() {
+  TEST_ASSERT_EQUAL_UINT16(NEON_NAVY,  NEON_BLUE);        // informational blue
+  TEST_ASSERT_EQUAL_UINT16(NEON_VIOLET, NEON_PURPLE);     // Bluetooth / violet family
+  TEST_ASSERT_EQUAL_UINT16(NEON_MAROON, NEON_RED);        // danger
+  TEST_ASSERT_EQUAL_UINT16(NEON_PINK,  NEON_MAGENTA);     // highlights
+  TEST_ASSERT_EQUAL_UINT16(NEON_GOLD,  NEON_YELLOW);      // attention
+  TEST_ASSERT_EQUAL_UINT16(NEON_DARKCYAN, NEON_CYAN);     // accent
+  TEST_ASSERT_EQUAL_UINT16(NEON_DARKGREEN, NEON_GREEN);   // success
+  TEST_ASSERT_EQUAL_UINT16(NEON_OLIVE, NEON_LIME);
+  TEST_ASSERT_EQUAL_UINT16(NEON_GREENYELLOW, NEON_LIME);
+}
+
+// Regression test for the reported problem: while wardriving, the WiFi and Bluetooth
+// counters were drawn in mint green and cyan, which on a 128 px panel read as one
+// colour. They must now be plainly different hues, not two near-neighbours.
+void test_wardriving_wifi_and_bluetooth_are_different_hues() {
+  TEST_ASSERT_TRUE(NEON_GREEN != NEON_PURPLE);
+  TEST_ASSERT_TRUE_MESSAGE(hue_sector(NEON_GREEN) != hue_sector(NEON_PURPLE),
+                           "WiFi and Bluetooth share a hue sector again");
+  // And the specific pair that looked alike: the accent must not be confusable with
+  // the success colour either.
+  TEST_ASSERT_TRUE_MESSAGE(hue_sector(NEON_GREEN) != hue_sector(NEON_CYAN),
+                           "the success colour is sitting in the cyan hue family");
+}
+
+// --- readability, measured rather than asserted by eye --------------------------
+
+void test_body_text_is_the_brightest_thing_on_the_panel() {
+  const float body = contrast_ratio(NEON_LIGHTGREY, marauder::kNeonBlack);
+  TEST_ASSERT_TRUE(body >= 10.0f);
+  // Body text must beat every accent, otherwise the eye is pulled off the text.
+  TEST_ASSERT_TRUE(body > contrast_ratio(NEON_CYAN, marauder::kNeonBlack));
+  TEST_ASSERT_TRUE(body > contrast_ratio(NEON_MAGENTA, marauder::kNeonBlack));
+  TEST_ASSERT_TRUE(body > contrast_ratio(NEON_ORANGE, marauder::kNeonBlack));
+  TEST_ASSERT_TRUE(body > contrast_ratio(NEON_RED, marauder::kNeonBlack));
+}
+
+void test_every_text_colour_is_readable_on_the_panel() {
+  const uint16_t text_colours[] = {
+      NEON_WHITE, NEON_LIGHTGREY, NEON_CYAN, NEON_GREEN, NEON_ORANGE, NEON_RED,
+      NEON_MAGENTA, NEON_YELLOW, NEON_BLUE, NEON_LIME, NEON_PURPLE, NEON_VIOLET,
+      NEON_SKYBLUE, NEON_SILVER, NEON_DARKGREY,
+      NEON_DARKCYAN, NEON_DARKGREEN, NEON_OLIVE, NEON_GREENYELLOW, NEON_PINK,
+      NEON_GOLD,
+  };
+  // NEON_NAVY and NEON_MAROON are deliberately not in this list: they are deep
+  // fills that sit behind bright text, never text themselves.
+  for (size_t i = 0; i < sizeof(text_colours) / sizeof(text_colours[0]); i++) {
+    const float ratio = contrast_ratio(text_colours[i], marauder::kNeonBlack);
+    TEST_ASSERT_TRUE_MESSAGE(ratio >= 4.5f,
+                             "a neon colour is not readable on the panel");
+  }
+}
+
+void test_status_bar_text_is_readable_on_the_status_bar() {
+  const uint16_t bar = marauder::kNeonStatusBar;
+  const uint16_t on_bar[] = {
+      NEON_WHITE, NEON_LIGHTGREY, NEON_CYAN, NEON_GREEN, NEON_RED, NEON_YELLOW,
+      NEON_ORANGE,
+  };
+  for (size_t i = 0; i < sizeof(on_bar) / sizeof(on_bar[0]); i++) {
+    const float ratio = contrast_ratio(on_bar[i], bar);
+    TEST_ASSERT_TRUE_MESSAGE(ratio >= 4.5f,
+                             "status bar text is not readable on the bar");
+  }
+  // The bar itself must be dark enough to read the panel background as a border.
+  TEST_ASSERT_TRUE(contrast_ratio(bar, marauder::kNeonBlack) < 2.0f);
+}
+
+// Regression test for the reported bug: menu entries built with TFTNAVY ("Add
+// SSIDs", "Select APs", "Save APs") and TFTPURPLE were rendered in a dark navy that
+// sat at 1.33:1 on black - invisible both as text and as a selected-row fill. There
+// is no colour in this palette that is exempt from the readability floor, because
+// MenuFunctions::getColor() hands every one of them to a menu label.
+void test_the_menu_colours_that_were_unreadable_are_now_bright() {
+  const uint16_t menu_colours[] = {
+      NEON_NAVY,     // "Add SSIDs", "Select APs", "Save APs"
+      NEON_MAROON,
+      NEON_PURPLE,   // "RDP Scan", "Google BLE Spam"
+      NEON_LIGHTGREY,  // the everyday menu item colour, 75 uses
+      NEON_CYAN,
+      NEON_GREEN,
+      NEON_BLUE,
+      NEON_DARKGREY,
+      NEON_OLIVE,
+      NEON_SKYBLUE,
+      NEON_VIOLET,
+      NEON_DARKCYAN,
+      NEON_DARKGREEN,
+  };
+  for (size_t i = 0; i < sizeof(menu_colours) / sizeof(menu_colours[0]); i++) {
+    const float as_text = contrast_ratio(menu_colours[i], marauder::kNeonBlack);
+    const float as_fill = contrast_ratio(menu_colours[i], marauder::kNeonTitleText);
+    // unselected: this colour drawn on the black panel
+    TEST_ASSERT_TRUE_MESSAGE(as_text >= 4.5f, "a menu colour is unreadable as text");
+    // selected: black text drawn on this colour
+    TEST_ASSERT_TRUE_MESSAGE(as_fill >= 4.5f, "a menu colour cannot carry black text");
+  }
+  // The specific value that was broken must be well clear of the floor, not scraping it.
+  TEST_ASSERT_TRUE(contrast_ratio(NEON_NAVY, marauder::kNeonBlack) > 5.0f);
+}
+
+void test_status_bar_is_not_the_stock_flat_grey() {
+  TEST_ASSERT_EQUAL_UINT16(0x1045, marauder::kNeonStatusBar);
+  TEST_ASSERT_EQUAL_UINT16(0x0021, marauder::kNeonTitleText);
+}
+
+void test_bright_fills_can_carry_dark_title_text() {
+  const uint16_t fills[] = {NEON_CYAN, NEON_GREEN, NEON_ORANGE, NEON_RED,
+                            NEON_MAGENTA, NEON_YELLOW, NEON_WHITE, NEON_LIME};
+  for (size_t i = 0; i < sizeof(fills) / sizeof(fills[0]); i++) {
+    const float ratio = contrast_ratio(fills[i], marauder::kNeonTitleText);
+    TEST_ASSERT_TRUE_MESSAGE(ratio >= 4.5f,
+                             "a title bar fill cannot carry dark text");
+  }
+}
+
+// --- the palette is more than one hue -------------------------------------------
+
+void test_palette_is_not_monochrome() {
+  const uint16_t accents[] = {NEON_CYAN, NEON_GREEN, NEON_ORANGE, NEON_RED,
+                              NEON_MAGENTA, NEON_YELLOW, NEON_BLUE, NEON_PURPLE,
+                              NEON_LIME};
+  bool seen[6] = {false, false, false, false, false, false};
+  int sectors = 0;
+  for (size_t i = 0; i < sizeof(accents) / sizeof(accents[0]); i++) {
+    const int sector = hue_sector(accents[i]);
+    if (sector >= 0 && !seen[sector]) {
+      seen[sector] = true;
+      sectors++;
+    }
+  }
+  // The failure this guards against: six saturated constants that all sit in one
+  // hue family, which reads as a single-colour screen however bright it is.
+  TEST_ASSERT_TRUE_MESSAGE(sectors >= 4, "the accent colours are one hue family");
+}
+
+void test_accents_are_distinguishable_from_each_other() {
+  const uint16_t accents[] = {NEON_CYAN, NEON_GREEN, NEON_ORANGE, NEON_RED,
+                              NEON_MAGENTA, NEON_YELLOW, NEON_BLUE, NEON_PURPLE,
+                              NEON_LIME, NEON_WHITE};
+  const size_t count = sizeof(accents) / sizeof(accents[0]);
+  for (size_t i = 0; i < count; i++) {
+    for (size_t j = i + 1; j < count; j++) {
+      TEST_ASSERT_TRUE_MESSAGE(accents[i] != accents[j],
+                               "two roles share one colour");
+    }
+  }
+}
+
+int main() {
+  UNITY_BEGIN();
+  RUN_TEST(test_every_colour_name_resolves_to_its_neon_entry);
+  RUN_TEST(test_body_text_is_the_brightest_thing_on_the_panel);
+  RUN_TEST(test_every_text_colour_is_readable_on_the_panel);
+  RUN_TEST(test_status_bar_text_is_readable_on_the_status_bar);
+  RUN_TEST(test_the_menu_colours_that_were_unreadable_are_now_bright);
+  RUN_TEST(test_status_bar_is_not_the_stock_flat_grey);
+  RUN_TEST(test_bright_fills_can_carry_dark_title_text);
+  RUN_TEST(test_palette_is_not_monochrome);
+  RUN_TEST(test_accents_are_distinguishable_from_each_other);
+  return UNITY_END();
+}
diff --git a/test/test_neon_theme_offtarget/test_main.cpp b/test/test_neon_theme_offtarget/test_main.cpp
new file mode 100644
index 0000000..5ee3d17
--- /dev/null
+++ b/test/test_neon_theme_offtarget/test_main.cpp
@@ -0,0 +1,85 @@
+#include <unity.h>
+
+#include <stdint.h>
+
+// The stock TFT_eSPI colour macros, mirrored here so this translation unit can
+// check the *non-Mini-v3* arm of NeonPalette.h without the display library. The
+// values are the ones TFT_eSPI 2.5.x defines; Display.cpp static_asserts them
+// against the real macros in a firmware build.
+#define TFT_NAVY        0x000F
+#define TFT_DARKGREEN   0x03E0
+#define TFT_DARKCYAN    0x03EF
+#define TFT_MAROON      0x7800
+#define TFT_PURPLE      0x780F
+#define TFT_OLIVE       0x7BE0
+#define TFT_LIGHTGREY   0xD69A
+#define TFT_DARKGREY    0x7BEF
+#define TFT_BLUE        0x001F
+#define TFT_GREEN       0x07E0
+#define TFT_CYAN        0x07FF
+#define TFT_RED         0xF800
+#define TFT_MAGENTA     0xF81F
+#define TFT_YELLOW      0xFFE0
+#define TFT_WHITE       0xFFFF
+#define TFT_ORANGE      0xFDA0
+#define TFT_GREENYELLOW 0xB7E0
+#define TFT_PINK        0xFE19
+#define TFT_GOLD        0xFEA0
+#define TFT_SILVER      0xC618
+#define TFT_SKYBLUE     0x867D
+#define TFT_VIOLET      0x915C
+#define TFT_LIME        0x97E0
+
+// NOTE: MARAUDER_MINI_V3 is deliberately NOT defined here. This is the arm every
+// other hardware target compiles.
+#include "NeonPalette.h"
+
+void setUp() {}
+void tearDown() {}
+
+// Each colour name must expand to the exact stock macro it replaced. If one were
+// mapped to the wrong token, another board would silently change colour - which is
+// exactly the failure mode that a single flat lookup table would have introduced.
+void test_every_colour_name_is_the_stock_macro_off_the_mini_v3() {
+  TEST_ASSERT_EQUAL_UINT16(TFT_NAVY,         NEON_NAVY);
+  TEST_ASSERT_EQUAL_UINT16(TFT_DARKGREEN,    NEON_DARKGREEN);
+  TEST_ASSERT_EQUAL_UINT16(TFT_DARKCYAN,     NEON_DARKCYAN);
+  TEST_ASSERT_EQUAL_UINT16(TFT_MAROON,       NEON_MAROON);
+  TEST_ASSERT_EQUAL_UINT16(TFT_PURPLE,       NEON_PURPLE);
+  TEST_ASSERT_EQUAL_UINT16(TFT_OLIVE,        NEON_OLIVE);
+  TEST_ASSERT_EQUAL_UINT16(TFT_LIGHTGREY,    NEON_LIGHTGREY);
+  TEST_ASSERT_EQUAL_UINT16(TFT_DARKGREY,     NEON_DARKGREY);
+  TEST_ASSERT_EQUAL_UINT16(TFT_BLUE,         NEON_BLUE);
+  TEST_ASSERT_EQUAL_UINT16(TFT_GREEN,        NEON_GREEN);
+  TEST_ASSERT_EQUAL_UINT16(TFT_CYAN,         NEON_CYAN);
+  TEST_ASSERT_EQUAL_UINT16(TFT_RED,          NEON_RED);
+  TEST_ASSERT_EQUAL_UINT16(TFT_MAGENTA,      NEON_MAGENTA);
+  TEST_ASSERT_EQUAL_UINT16(TFT_YELLOW,       NEON_YELLOW);
+  TEST_ASSERT_EQUAL_UINT16(TFT_WHITE,        NEON_WHITE);
+  TEST_ASSERT_EQUAL_UINT16(TFT_ORANGE,       NEON_ORANGE);
+  TEST_ASSERT_EQUAL_UINT16(TFT_GREENYELLOW,  NEON_GREENYELLOW);
+  TEST_ASSERT_EQUAL_UINT16(TFT_PINK,         NEON_PINK);
+  TEST_ASSERT_EQUAL_UINT16(TFT_GOLD,         NEON_GOLD);
+  TEST_ASSERT_EQUAL_UINT16(TFT_SILVER,       NEON_SILVER);
+  TEST_ASSERT_EQUAL_UINT16(TFT_SKYBLUE,      NEON_SKYBLUE);
+  TEST_ASSERT_EQUAL_UINT16(TFT_VIOLET,       NEON_VIOLET);
+  TEST_ASSERT_EQUAL_UINT16(TFT_LIME,         NEON_LIME);
+}
+
+// The other direction: the off-target arm must NOT be the neon palette. If it were,
+// every other board would silently change colour.
+void test_off_target_macros_are_not_the_neon_palette() {
+  TEST_ASSERT_EQUAL_UINT16(0x07FF, NEON_CYAN);
+  TEST_ASSERT_NOT_EQUAL(marauder::kNeonAccent, NEON_CYAN);
+  TEST_ASSERT_EQUAL_UINT16(0xD69A, NEON_LIGHTGREY);
+  TEST_ASSERT_NOT_EQUAL(marauder::kNeonBody, NEON_LIGHTGREY);
+  TEST_ASSERT_EQUAL_UINT16(0xFFE0, NEON_YELLOW);
+  TEST_ASSERT_NOT_EQUAL(marauder::kNeonAlert, NEON_YELLOW);
+}
+
+int main() {
+  UNITY_BEGIN();
+  RUN_TEST(test_every_colour_name_is_the_stock_macro_off_the_mini_v3);
+  RUN_TEST(test_off_target_macros_are_not_the_neon_palette);
+  return UNITY_END();
+}
diff --git a/tools/build_mini_v3.sh b/tools/build_mini_v3.sh
new file mode 100755
index 0000000..bff65f6
--- /dev/null
+++ b/tools/build_mini_v3.sh
@@ -0,0 +1,172 @@
+#!/usr/bin/env bash
+#
+# Build the ESP32 Marauder firmware for the Marauder Mini v3 (ESP32-C5).
+#
+# This mirrors .github/workflows/build_parallel.yml, which is the only place the
+# project records how a target is assembled: same Arduino ESP32 core, same pinned
+# library revisions, and the same TFT_eSPI configuration step. The Mini v3 build
+# itself lives in a private TFT repository upstream, so the panel setup file
+# (User_Setup_marauder_mini_v3.h) is carried in this repository instead.
+#
+# Usage:  tools/build_mini_v3.sh [work-dir]
+#
+# Produces <work-dir>/out/esp32_marauder.ino.bin (application image, links at
+# 0x10000) plus the bootloader and partition table needed for a factory image.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+REPO_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
+WORK_DIR="${1:-${REPO_DIR}/../miniv3-build}"
+LIB_DIR="${WORK_DIR}/libs"
+OUT_DIR="${WORK_DIR}/out"
+SKETCH_DIR="${REPO_DIR}/esp32_marauder"
+
+FQBN="esp32:esp32:esp32c5:FlashSize=8M,PartitionScheme=default_8MB,PSRAM=enabled"
+CORE_VERSION="3.3.4"
+APPLICATION_LIMIT=$((0x330000))
+
+# TFT_eSPI needs the ESP32-C5 port; the upstream Bodmer release has no C5 support.
+TFT_REPO="https://github.com/H4W9/TFT_eSPI.git"
+TFT_REF="ESP32-C5"
+
+if [[ -n "${ARDUINO_CLI_BIN:-}" ]]; then
+  ARDUINO_CLI="${ARDUINO_CLI_BIN}"
+elif command -v arduino-cli >/dev/null 2>&1; then
+  ARDUINO_CLI="$(command -v arduino-cli)"
+elif [[ -x "${HOME}/bin/arduino-cli" ]]; then
+  ARDUINO_CLI="${HOME}/bin/arduino-cli"
+else
+  echo "arduino-cli not found; install it or set ARDUINO_CLI_BIN" >&2
+  exit 1
+fi
+
+installed_core="$("${ARDUINO_CLI}" core list | awk '$1 == "esp32:esp32" {print $2}')"
+if [[ "${installed_core}" != "${CORE_VERSION}" ]]; then
+  echo "ESP32 Arduino core ${CORE_VERSION} required; found ${installed_core:-none}" >&2
+  echo "Install it with: ${ARDUINO_CLI} core install esp32:esp32@${CORE_VERSION}" >&2
+  exit 1
+fi
+
+# arduino-cli generates function prototypes for .ino sketches with its own
+# bundled ctags, which is an x86_64 binary. On Apple silicon it needs Rosetta 2;
+# without it the build aborts before compiling anything with
+# "bad CPU type in executable".
+#
+# Do NOT substitute a native ctags build here. arduino-cli parses ctags output
+# with a parser written against Exuberant Ctags 5.8, and a current Universal
+# Ctags emits slightly different fields - the prototypes it generates then
+# corrupt the sketch (stray tokens reported inside unrelated #ifdefs). Install
+# Rosetta instead:
+#
+#   softwareupdate --install-rosetta --agree-to-license
+if [[ "$(uname -s)" == "Darwin" && "$(uname -m)" == "arm64" ]]; then
+  bundled_ctags="${HOME}/Library/Arduino15/packages/builtin/tools/ctags/5.8-arduino11/ctags"
+  if [[ -f "${bundled_ctags}" ]] && ! "${bundled_ctags}" --version >/dev/null 2>&1; then
+    echo "arduino-cli's bundled ctags (x86_64) cannot run on this machine." >&2
+    echo "Install Rosetta 2 and retry:" >&2
+    echo "  softwareupdate --install-rosetta --agree-to-license" >&2
+    exit 1
+  fi
+fi
+
+mkdir -p "${LIB_DIR}" "${OUT_DIR}"
+
+clone_pinned() {
+  local name="$1" url="$2" ref="$3"
+  if [[ -d "${LIB_DIR}/${name}/.git" ]]; then
+    return
+  fi
+  rm -rf "${LIB_DIR}/${name}"
+  echo "fetching ${name} @ ${ref}"
+  git clone --depth 1 --branch "${ref}" "${url}" "${LIB_DIR}/${name}"
+}
+
+clone_pinned AsyncTCP         https://github.com/ESP32Async/AsyncTCP.git        v3.4.8
+clone_pinned ESPAsyncWebServer https://github.com/ESP32Async/ESPAsyncWebServer.git v3.8.1
+clone_pinned ESP32Ping        https://github.com/marian-craciunescu/ESP32Ping.git 1.6
+clone_pinned MicroNMEA        https://github.com/stevemarple/MicroNMEA.git      v2.0.6
+clone_pinned NimBLE-Arduino   https://github.com/h2zero/NimBLE-Arduino.git      2.3.8
+clone_pinned ArduinoJson      https://github.com/bblanchon/ArduinoJson.git      v7.4.2
+clone_pinned LinkedList       https://github.com/ivanseidel/LinkedList.git      master
+clone_pinned EspSoftwareSerial https://github.com/plerup/espsoftwareserial.git  8.1.0
+
+# Adafruit_TCA8418 is carried in this repository and is not on GitHub under a
+# pinnable revision.
+rm -rf "${LIB_DIR}/Adafruit_TCA8418"
+cp -r "${REPO_DIR}/libraries/Adafruit_TCA8418" "${LIB_DIR}/Adafruit_TCA8418"
+
+# TFT_eSPI is cloned into its own folder and configured here so the build never
+# edits a shared checkout.
+if [[ ! -d "${LIB_DIR}/TFT_eSPI/.git" ]]; then
+  rm -rf "${LIB_DIR}/TFT_eSPI"
+  git clone --depth 1 --branch "${TFT_REF}" "${TFT_REPO}" "${LIB_DIR}/TFT_eSPI"
+fi
+
+# Same configuration step the release workflow performs.
+rm -f "${LIB_DIR}/TFT_eSPI/User_Setup_Select.h"
+cp "${REPO_DIR}"/User*.h "${LIB_DIR}/TFT_eSPI/"
+sed -i.bak \
+  's|^//#include <User_Setup_marauder_mini_v3.h>|#include <User_Setup_marauder_mini_v3.h>|' \
+  "${LIB_DIR}/TFT_eSPI/User_Setup_Select.h"
+rm -f "${LIB_DIR}/TFT_eSPI/User_Setup_Select.h.bak"
+
+if ! grep -q '^#include <User_Setup_marauder_mini_v3.h>' \
+    "${LIB_DIR}/TFT_eSPI/User_Setup_Select.h"; then
+  echo "failed to select the Mini v3 TFT_eSPI setup" >&2
+  exit 1
+fi
+
+# Core 3.3.4 needs the same two adjustments the release workflow applies:
+# -zmuldefs for the duplicated C symbols in the ESP32 Arduino libraries, and no
+# exceptions so the firmware stays inside its size budget.
+CORE_DIR="${HOME}/Library/Arduino15/packages/esp32/hardware/esp32/${CORE_VERSION}"
+if [[ ! -d "${CORE_DIR}" ]]; then
+  CORE_DIR="${HOME}/.arduino15/packages/esp32/hardware/esp32/${CORE_VERSION}"
+fi
+if [[ ! -d "${CORE_DIR}" ]]; then
+  echo "could not locate the installed esp32 core directory" >&2
+  exit 1
+fi
+
+if [[ "$(uname -s)" == "Darwin" ]]; then
+  SED_INPLACE=(sed -i.bak)
+else
+  SED_INPLACE=(sed -i.bak)
+fi
+
+"${SED_INPLACE[@]}" 's|^compiler.c.elf.extra_flags=.*|compiler.c.elf.extra_flags=-Wl,-zmuldefs |' \
+  "${CORE_DIR}/platform.txt"
+rm -f "${CORE_DIR}/platform.txt.bak"
+
+# The bundled Arduino libraries are built by a separate step; drop C++ exceptions
+# there too so the final link does not pull the exception machinery back in.
+find "${HOME}/.arduino15" "${HOME}/Library/Arduino15" \
+  -path "*esp32-arduino-libs*" -name cpp_flags -print0 2>/dev/null \
+  | xargs -0 -r "${SED_INPLACE[@]}" 's|-fexceptions|-fno-exceptions|g' 2>/dev/null || true
+find "${HOME}/.arduino15" "${HOME}/Library/Arduino15" \
+  -path "*esp32-arduino-libs*" -name 'cpp_flags.bak' -delete 2>/dev/null || true
+
+echo "compiling ${FQBN}"
+"${ARDUINO_CLI}" compile \
+  --fqbn "${FQBN}" \
+  --libraries "${LIB_DIR}" \
+  --warnings none \
+  --build-property "compiler.cpp.extra_flags=-DMARAUDER_MINI_V3" \
+  --build-property "compiler.c.extra_flags=-DMARAUDER_MINI_V3" \
+  --output-dir "${OUT_DIR}" \
+  "${SKETCH_DIR}"
+
+APP_IMAGE="${OUT_DIR}/esp32_marauder.ino.bin"
+if [[ ! -f "${APP_IMAGE}" ]]; then
+  echo "expected ${APP_IMAGE} to exist" >&2
+  exit 1
+fi
+
+app_size="$(stat -f '%z' "${APP_IMAGE}" 2>/dev/null || stat -c '%s' "${APP_IMAGE}")"
+if (( app_size > APPLICATION_LIMIT )); then
+  echo "application is ${app_size} bytes and exceeds the ${APPLICATION_LIMIT}-byte slot" >&2
+  exit 1
+fi
+
+echo "build complete: ${APP_IMAGE} (${app_size}/${APPLICATION_LIMIT} bytes)"
diff --git a/tools/generate_boot_scene.py b/tools/generate_boot_scene.py
