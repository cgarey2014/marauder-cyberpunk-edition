+// A block of data lines where every field name and every value is the same colour is
+// hard to read: nothing tells the eye where a value starts or what kind of value it is.
+// This prints one "Name: value" record with the name dimmed and the value in a colour
+// chosen for its kind (addresses one colour, counts another, and so on), so a screen can
+// be skimmed by shape. Wrapping behaves exactly as printWrapped's does, and the cursor is
+// left in the same place.
+void Display::printRecord(const String& line, uint16_t value_colour) {
+  #ifdef MARAUDER_MINI_V3
+    const int16_t start_x = tft.getCursorX();
+    const int16_t start_y = tft.getCursorY();
+    const int16_t row_height = 8 * tft.textsize;
+
+    // Everything up to and including the first colon is the field name.
+    const int colon = line.indexOf(':');
+    const int label_end = (colon < 0) ? 0 : colon + 1;
+
+    const uint16_t row_count = displayLineRowCount(line.c_str(), STANDARD_FONT_CHAR_LIMIT);
+    char row_text[STANDARD_FONT_CHAR_LIMIT + 1];
+
+    for (uint16_t row_index = 0; row_index < row_count; row_index++) {
+      copyDisplayLineRow(row_text, sizeof(row_text), line.c_str(), row_index,
+                         STANDARD_FONT_CHAR_LIMIT);
+      const int row_start = (int)row_index * STANDARD_FONT_CHAR_LIMIT;
+      const int row_len = (int)strlen(row_text);
+      tft.setCursor(start_x, start_y + (row_index * row_height));
+
+      if (label_end >= row_start + row_len) {
+        tft.setTextColor(NEON_DARKGREY);          // a row that is all field name
+        tft.print(row_text);
+      } else if (label_end <= row_start) {
+        tft.setTextColor(value_colour);           // a row that is all value
+        tft.print(row_text);
+      } else {
+        // The colon falls inside this row, so it carries both.
+        char name_part[STANDARD_FONT_CHAR_LIMIT + 1];
+        const int cut = label_end - row_start;
+        memcpy(name_part, row_text, cut);
+        name_part[cut] = '\0';
+        tft.setTextColor(NEON_DARKGREY);
+        tft.print(name_part);
+        tft.setTextColor(value_colour);
+        tft.print(row_text + cut);
+      }
+    }
+
+    tft.setCursor(0, start_y + (row_count * row_height));
+  #else
+    tft.println(line);
+  #endif
+}
+
+// Prints `text` as `println` would, except that anything longer than one row is
+// continued on the rows below instead of being clipped at the panel edge.
+// Values that overflow a 128 px panel are the interesting case: a MAC address
+// with a label ("   BSSID: AA:BB:CC:DD:EE:FF") is 27 characters, so the previous
+// single-line print showed only the first 21 and the tail of the address - the
+// part that identifies the device - was lost.
+//
+// Every other target keeps the original single-line behaviour, so their output
+// is byte for byte what it was.
+void Display::printWrapped(const char* text) {
+  if (text == nullptr)
+    text = "";
+
+  #ifdef MARAUDER_MINI_V3
+    const int16_t start_x = tft.getCursorX();
+    const int16_t start_y = tft.getCursorY();
+    // TFT_eSPI advances the cursor by 8 * textsize pixels per newline for the
+    // built-in fonts, which is also the row pitch used below.
+    const int16_t row_height = 8 * tft.textsize;
+
+    const uint16_t row_count =
+        displayLineRowCount(text, STANDARD_FONT_CHAR_LIMIT);
+    char row_text[STANDARD_FONT_CHAR_LIMIT + 1];
+
+    for (uint16_t row_index = 0; row_index < row_count; row_index++) {
+      copyDisplayLineRow(row_text, sizeof(row_text), text, row_index,
+                         STANDARD_FONT_CHAR_LIMIT);
+      tft.setCursor(start_x, start_y + (row_index * row_height));
+      tft.print(row_text);
+    }
+
+    // Leave the cursor exactly where a single println would have left it.
+    tft.setCursor(0, start_y + (row_count * row_height));
+  #else
+    tft.println(text);
+  #endif
+}
