+// Upper bound on the number of display rows one logical line may occupy.
+// Guards against pathological input (and a runaway print loop) on the narrow
+// 128 px panels.
+constexpr uint16_t kDisplayLineMaxRows = 12;
+
 void fitDisplayLine(char* output, size_t output_size, const char* input);
 uint8_t resolveDisplayTextSize(bool small_print, uint8_t requested_size);
+
+// Number of display rows `input` needs when `capacity` characters fit on a row.
+// An embedded '\n' forces a row break; the character after it starts a new row.
+// A null or empty input still occupies one (empty) row.
+uint16_t displayLineRowCount(const char* input, uint16_t capacity);
+
+// Copies row `row` of `input` into `output`, which is always NUL terminated and
+// never padded. Rows past the end of the input copy an empty string. Returns
+// the number of characters copied.
+size_t copyDisplayLineRow(char* output, size_t output_size, const char* input,
+                          uint16_t row, uint16_t capacity);
