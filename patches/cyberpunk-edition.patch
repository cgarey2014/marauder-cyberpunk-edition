+
+void test_zero_row_capacity_is_treated_as_one() {
+  char row[8];
+  TEST_ASSERT_EQUAL_UINT16(3, displayLineRowCount("abc", 0));
+  copyDisplayLineRow(row, sizeof(row), "abc", 1, 0);
