+// --- Mini v3 COSMO splash: every band must own disjoint rows ---
+
+void test_cosmo_layout_mini_v3_bands_are_disjoint() {
+  const marauder::CosmoSplashLayout layout =
+      marauder::cosmoSplashLayout(128, 128);
+
+  TEST_ASSERT_EQUAL_INT16(1, layout.title_y);
+  TEST_ASSERT_EQUAL_INT16(0, layout.scene_x);
+  TEST_ASSERT_EQUAL_INT16(10, layout.scene_y);
+  TEST_ASSERT_EQUAL_INT16(128, layout.scene_width);
+  TEST_ASSERT_EQUAL_INT16(72, layout.scene_height);
+  TEST_ASSERT_EQUAL_INT16(83, layout.wordmark_y);
+  TEST_ASSERT_EQUAL_INT16(99, layout.wordmark2_y);
+  TEST_ASSERT_EQUAL_INT16(108, layout.tagline_y);
+  TEST_ASSERT_EQUAL_INT16(116, layout.version_y);
+}
+
+// "CYBERPUNK EDITION" on a single font 2 line is 9 + 1 + 7 characters at 8 px each -
+// 136 px - which is wider than the 128 px panel. That is why the wordmark is two lines
+// and why this test exists: the second word has to fit on its own row beneath the first.
+void test_cosmo_layout_wordmark_is_two_lines_that_fit() {
+  constexpr int16_t panel_width = 128;
+  const marauder::CosmoSplashLayout layout =
+      marauder::cosmoSplashLayout(128, 128);
+
+  TEST_ASSERT_EQUAL_INT16(layout.wordmark_y + 16, layout.wordmark2_y);
+  TEST_ASSERT_GREATER_OR_EQUAL_INT16(layout.wordmark2_y + 8, layout.tagline_y);
+
+  // "CYBERPUNK" at font 2 and "EDITION" at the GLCD font, both centred.
+  TEST_ASSERT_LESS_OR_EQUAL_INT16(panel_width, 9 * 8);
+  TEST_ASSERT_LESS_OR_EQUAL_INT16(panel_width, 7 * 6);
+}
+
+void test_cosmo_layout_fits_the_panel() {
+  const int16_t width = 128;
+  const int16_t height = 128;
+  const marauder::CosmoSplashLayout layout =
+      marauder::cosmoSplashLayout(width, height);
+
+  TEST_ASSERT_GREATER_OR_EQUAL_INT16(0, layout.title_y);
+  TEST_ASSERT_GREATER_OR_EQUAL_INT16(0, layout.scene_x);
+  TEST_ASSERT_GREATER_OR_EQUAL_INT16(0, layout.scene_y);
+  TEST_ASSERT_LESS_OR_EQUAL_INT16(width, layout.scene_x + layout.scene_width);
+
+  // Bands are stacked in order with no overlap: each starts at or after the
+  // previous one ends.
+  TEST_ASSERT_GREATER_OR_EQUAL_INT16(layout.title_y + 8, layout.scene_y);
+  TEST_ASSERT_GREATER_OR_EQUAL_INT16(layout.scene_y + layout.scene_height,
+                                     layout.wordmark_y);
+  TEST_ASSERT_GREATER_OR_EQUAL_INT16(layout.wordmark_y + 16, layout.wordmark2_y);
+  TEST_ASSERT_GREATER_OR_EQUAL_INT16(layout.wordmark2_y + 8, layout.tagline_y);
+  TEST_ASSERT_GREATER_OR_EQUAL_INT16(layout.tagline_y + 8, layout.version_y);
+
+  // The wordmark's two lines are 16 px and 8 px, and the tagline and version 8 px each.
+  TEST_ASSERT_LESS_OR_EQUAL_INT16(height, layout.version_y + 8);
+}
+
+void test_cosmo_layout_shifts_up_on_a_shorter_panel() {
+  const marauder::CosmoSplashLayout tall =
+      marauder::cosmoSplashLayout(128, 128);
+  const marauder::CosmoSplashLayout short_panel =
+      marauder::cosmoSplashLayout(128, 112);
+
+  TEST_ASSERT_LESS_OR_EQUAL_INT16(112, short_panel.version_y + 8);
+  TEST_ASSERT_LESS_THAN_INT16(tall.version_y, short_panel.version_y);
+  TEST_ASSERT_EQUAL_INT16(tall.scene_height, short_panel.scene_height);
+}
+
 int main() {
   UNITY_BEGIN();
   RUN_TEST(test_layout_fits_mini_v3);
   RUN_TEST(test_layout_fits_v8_with_half_size_logo);
   RUN_TEST(test_layout_fits_landscape_and_square_displays);
+  RUN_TEST(test_cosmo_layout_mini_v3_bands_are_disjoint);
+  RUN_TEST(test_cosmo_layout_wordmark_is_two_lines_that_fit);
+  RUN_TEST(test_cosmo_layout_fits_the_panel);
+  RUN_TEST(test_cosmo_layout_shifts_up_on_a_shorter_panel);
   return UNITY_END();
 }
+
