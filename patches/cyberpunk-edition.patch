+void Display::drawCentreTitle(const String& text, int16_t centre_x, int y, uint8_t font)
+{
+  #ifdef MARAUDER_MINI_V3
+    // The Mini v3 panel is 128 px wide and font 2 is about 8 px per glyph, so a
+    // title only fits 16 characters. Drop to the 6 px font rather than lose the
+    // end of the title.
+    uint8_t chosen_font = font;
+    while ((chosen_font > 1) && (tft.textWidth(text, chosen_font) > SCREEN_WIDTH))
